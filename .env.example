# cv-elm project env.
#
# CAREER_PROFILE_DIR points the career-agent sync script
# (worker/scripts/sync-career-profile.mjs) at the canonical Career Profile
# directory in the Obsidian vault. The vault is the single source of truth;
# `npm run sync` (in worker/) regenerates the agent's corpus from it.
#
# Copy to `.env` and adjust if your vault lives elsewhere.
CAREER_PROFILE_DIR=/Users/opsb/Dropbox/second-brain/01 Projects/Next opportunity/Career Profile
